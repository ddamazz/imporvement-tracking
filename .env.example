# Neon Postgres — the pooled connection string from your Neon project.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob — `vercel env pull` writes this once a Blob store exists.
# The store must use PRIVATE access; screenshots are served via /api/images/[id].
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# The shared password everyone types to get in.
TRAKKER_PASSWORD="form999"

# Signs the session cookie. Generate with: openssl rand -hex 32
# Changing it logs everyone out.
AUTH_SECRET="replace-me-with-a-random-32-byte-hex-string"
